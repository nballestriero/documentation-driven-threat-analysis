digraph G {
  graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.28", ranksep="0.45", splines=ortho];
  node [shape=box, style="rounded", fontname="Helvetica", fontsize=10, margin="0.12,0.08", color="#333333", fontcolor="#111111", penwidth=1.1];
  edge [color="#444444", penwidth=1.0, arrowsize=0.7, fontname="Helvetica", fontsize=8, fontcolor="#333333"];

  meta [label="Conceptual metamodel\nmeaning | relations | invariants", width=3.5];
  canonical [label="Canonical document model", width=3.5];
  sem [label="Semantic contract\nfields | types | cardinalities\nnullability | invariants", width=2.8];
  rep [label="Representation profiles\nmaterial presence | order\nheadings | mappings | mirrors", width=2.8];
  exec [label="Executable projections\nderived, not parallel authorities", width=3.5];

  validator [label="Validators / gates", width=1.7];
  editor [label="Editor schemas\n& diagnostics", width=1.7];
  author [label="Authoring / LLM\ncontext & guidance", width=1.9];
  machine [label="Machine contracts\n/ schemas", width=1.7];

  meta -> canonical [label="specialize into governed document models"];
  canonical -> sem;
  canonical -> rep;
  {rank=same; sem; rep}
  sem -> exec;
  rep -> exec;
  exec -> validator;
  exec -> editor;
  exec -> author;
  exec -> machine;
  {rank=same; validator; editor; author; machine}
}
