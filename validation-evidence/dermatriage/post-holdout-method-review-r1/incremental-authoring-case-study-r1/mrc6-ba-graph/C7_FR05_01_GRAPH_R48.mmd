    B4 -->|"transfer BAP-FRC7-05-01-04"| C705_OBS_READ
    C705_OBS_READ --> C705_V_READ
    C705_V_READ -->|"produce BAP-FRC7-05-01-01"| C705_DEC_READ
    C705_RULE_READ -.- C705_DEC_READ
    C705_DEC_READ -->|"true"| C705_OUT_READ
    C705_DEC_READ -.->|"false"| C705_GAP_READ

    %% B4 health
    C705_V_HEALTH -->|"transfer BAP-FRC7-05-01-03"| C705_REQ_HEALTH
    C705_REQ_HEALTH --> B4
    B4 -->|"transfer BAP-FRC7-05-01-04"| C705_OBS_HEALTH
    C705_OBS_HEALTH --> C705_V_HEALTH
    C705_V_HEALTH -->|"produce BAP-FRC7-05-01-01"| C705_DEC_HEALTH
    C705_RULE_HEALTH -.- C705_DEC_HEALTH
    C705_DEC_HEALTH -->|"true"| C705_OUT_HEALTH
    C705_DEC_HEALTH -.->|"false"| C705_GAP_HEALTH

    %% Red dashed edges below show unresolved applicability, NOT proven bearer transfers.
    %% B4BearerJWT is documented for B4 authenticated calls in general.
    %% The original B4 test matrix does not assign Bearer JWT to each endpoint separately.
    B4BearerJWT -.->|"transfer"| C705_JWT_Q_LIST
    C705_JWT_Q_LIST -.-> C705_REQ_LIST
    B4BearerJWT -.->|"transfer"| C705_JWT_Q_IMAGE
    C705_JWT_Q_IMAGE -.-> C705_REQ_IMAGE
    B4BearerJWT -.->|"transfer"| C705_JWT_Q_WRITE
    C705_JWT_Q_WRITE -.-> C705_REQ_WRITE
    B4BearerJWT -.->|"transfer"| C705_JWT_Q_READ
    C705_JWT_Q_READ -.-> C705_REQ_READ
    B4BearerJWT -.->|"transfer"| C705_JWT_Q_HEALTH
    C705_JWT_Q_HEALTH -.-> C705_REQ_HEALTH

