%% G6 accepted increment: G5 baseline + FR-C6-01-03A1 Google Drive acquisition and local model Store - R9 repository review.
%%
%% G6 VIEW CONTRACT: preserve G5 layout while adding only the accepted A1 acquisition/Store semantics.
%%   - preserve the accepted G5 semantic content;
%%   - keep DataResources unchanged semantically, but give its B/C review cards more room;
%%   - keep ModelResources on the right side of DermaTriageEnvironment so realize edges stay short;
%%   - keep ActiveClassifierStore below the other ModelResources members; its containment maps to BAP-FRC6-01-03A1-05;
%%   - keep GoogleDriveModelStore outside DermaTriageEnvironment;
%%   - increase the horizontal source/content gap so the transfer label remains readable;
%%   - place the Google Drive locator below EnvironmentSetupProcedure and separate from the transfer path.
%%
%% Projection semantics:
%%   visual containment = hasPart view semantics;
%%   explicit labeled edges = other BA operators;
%%   dashed amber cards under DataResources remain documentation-only BA-PENDING elements.
%%
%% Accepted BA additions projected in G6:
%%   BAP-FRC6-01-03A1-04 transfer: GoogleDriveModelStore -> EfficientNetB4WeightsArtifact -> ActiveClassifierStore
%%   BAP-FRC6-01-03A1-05 hasPart: ModelResources -> ActiveClassifierStore
%% NOTE: Mermaid may choose a different automatic geometry when rendered directly.
%% The companion vector PDF is the layout-stabilized review projection; this .mmd remains the
%% retained semantic/projection source for future incremental edits.

subgraph MRC6["MR-C6 - Predisposizione e inizializzazione dell'ambiente DermaTriage"]
  DT["DermaTriage\nBAReferent - system"]
  EP["EnvironmentPreparation\nBAReferent - preparation responsibility"]
  PROC["EnvironmentSetupProcedure\nBAReferent - realization"]

  subgraph ENV["DermaTriageEnvironment\nBAReferent - execution environment / whole"]
    direction LR

    subgraph BASE[" "]
      direction TB
      CR["ComputeResources\nBAP-MRC6-03 - direct hasPart"]
      SC["SoftwareComponents\nBAP-MRC6-04 - direct hasPart"]

      subgraph DR["DataResources\nBAP-MRC6-06 - direct hasPart"]
        direction TB
        RAG["DOC / BA PENDING\nFR-C6-01-03B [review]\nDermaTriage RAG Dataset\ndata/RAG_dataset.csv - 2,298 records"]
        IMG["DOC / BA PENDING - FR-C6-01-03C\nTraining images - data/images/ - circa 2 GB"]
      end

      EC["EnvironmentConfiguration\nBAP-MRC6-07 - direct hasPart"]
    end

    subgraph MR["ModelResources\nBAReferent - resource family\navailability=required - BAP-FRC6-01-03-07"]
      direction TB
      IUA["ImageUrgencyAnalysis"]
      CDG["ClinicalDescriptionGeneration"]
      EMB["HistoricalCaseEmbeddingGeneration\nClinicalDescriptionEmbeddingGeneration"]
      MTS["MultiSourceTriageSynthesis"]
      ACS[("ActiveClassifierStore\nstore / destination\nlocator: models/efficientnet_b4.pth\nrelative to image_classifier/")]

      %% projection-only ordering hints; no BA semantics
      IUA ~~~ CDG
      CDG ~~~ EMB
      EMB ~~~ MTS
      MTS ~~~ ACS
    end
  end

  EN["EfficientNet-B4\ncurrent realization"]
  QW["Qwen2-VL-7B-Instruct\ncurrent realization"]
  MINI["all-MiniLM-L6-v2\ncurrent realization"]
  BIO["BioMistral-7B\ncurrent realization"]

  %% FR-C6-01-03A1 acquisition slice.
  GDLOC["locator: Google Drive file URL"]
  GDS[("GoogleDriveModelStore\nstore / source")]
  WGT@{ shape: doc, label: "EfficientNetB4WeightsArtifact\ncontent\nefficientnet_b4.pth\nEfficientNet-B4 weights - 72 MB" }

  HCP["HardwareConfigurationProfile\nBAReferent - active configuration profile"]
  SWREQ["RequiredSoftwareDependencies\nBAReferent - governed logical dependency configuration"]
  SCP["SCP-C6-01-02\nrequirements.txt"]

  DT -->|"dependOn\nBAP-MRC6-02"| ENV
  EP -->|"produce\nBAP-MRC6-01"| ENV
  PROC -.->|"realize\nBAP-DECC6-01-01"| EP
  HCP -.->|"constrain\nBAP-FRC6-01-01-05"| ENV
  SWREQ -.->|"constrain\nBAP-FRC6-01-02-01"| ENV
  SCP -.->|"realize\nBAP-FRC6-01-02-02"| SWREQ

  IUA -.->|"realize\nBAP-FR03-01-02"| EN
  CDG -.->|"realize\nBAP-FR03-02-02"| QW
  EMB -.->|"realize\nBAP-FR03-03-07 / -05"| MINI
  MTS -.->|"realize\nBAP-FR03-04-02"| BIO

  %% One transfer proposition: source -> content -> destination.
  GDS -->|"transfer\nBAP-FRC6-01-03A1-04"| WGT
  WGT --> ACS
  GDLOC -.- GDS
end

class DT,EP,PROC,SWREQ core;
class ENV env;
class CR,SC,EC,DR part;
class IUA,CDG,EMB,MTS logical;
class EN,QW,MINI,BIO realization;
class GDS,ACS store;
class WGT content;
class GDLOC binding;
class HCP,SCP profile;
class RAG,IMG docpending;

